# Runtime
APP_ENV=demo
OUTPUT_DIR=outputs
DATA_DIR=data

# LLM: OpenRouter is the default OpenAI-compatible provider.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Research and scraping
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/instagram-scraper
TAVILY_API_KEY=
EXA_API_KEY=

# Video generation. Leave blank to use a storyboard-only demo.
OPENMONTAGE_API_KEY=
OPENMONTAGE_BASE_URL=

